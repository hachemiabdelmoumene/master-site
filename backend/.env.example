# =======================================================
# Variables d'Environnement - Backend Django
# =======================================================

# Mode Développement (True en local, False en production)
DJANGO_DEBUG=True

# Clé secrète Django (Générez une clé aléatoire forte en production)
DJANGO_SECRET_KEY=votre_cle_secrete_ultra_securisee_d_au_moins_50_caracteres_ici

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Domaines autorisés pour les requêtes CORS (URL de votre Frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://master-info-frontend.onrender.com

# Domaines de confiance pour la protection CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://master-info-frontend.onrender.com

# Base de données PostgreSQL (Fournie automatiquement par Render)
# Laisser vide en local pour utiliser SQLite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Initialisation des données au build (seed_data)
SEED_ON_BUILD=true
SEED_ADMIN_PASSWORD=admin123
SEED_HACHE_PASSWORD=hache1234
SEED_SSI_PASSWORD=ssi123
SEED_RSD_PASSWORD=rsd123
